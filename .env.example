# Copy to .env and change before deploying anywhere real.
# Shared by the gateway (verify), user-service (sign) and realtime-service (verify). At least 32 characters.
JWT_SECRET=dev-only-secret-change-me-please-32-bytes-min

POSTGRES_USER=booking
POSTGRES_PASSWORD=booking

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Optional: seeds an admin account (can create/edit catalog items via the API)
ADMIN_EMAIL=admin@booking.local
ADMIN_PASSWORD=admin12345
